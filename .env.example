# Свързване със Supabase (По избор)
# Без тези ключове публичният сайт използва примерни данни. Демо панелът изисква NEXT_PUBLIC_ENABLE_DEMO=true.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Имейл напомняния през Resend (по избор за реално изпращане)
RESEND_API_KEY=re_your_api_key

# Google вход: role=admin в profiles или app_metadata. Демо режимът е изключен по подразбиране.
NEXT_PUBLIC_ENABLE_DEMO=false

# САМО сървърни Netlify environment variables (Functions scope, production context)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-key
REMINDERS_ENABLED=false
REMINDER_EMAIL_FROM=Кабинет <appointments@your-verified-domain.example>
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-server-only-auth-token
TWILIO_FROM_NUMBER=your-approved-sender
